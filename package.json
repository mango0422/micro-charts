{
  "name": "@mango0422/micro-charts",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency chart library inspired by uPlot. Canvas-based, high performance.",
  "author": "mango0422",
  "license": "MIT",
  "keywords": [
    "charts",
    "canvas",
    "visualization",
    "lightweight",
    "typescript",
    "zero-dependency",
    "uplot",
    "gauge",
    "pie",
    "bar",
    "progress"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mango0422/micro-charts"
  },
  "homepage": "https://github.com/mango0422/micro-charts#readme",
  "bugs": {
    "url": "https://github.com/mango0422/micro-charts/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
