{
  "name": "@mango0422/micro-charts",
  "version": "0.2.2",
  "description": "Lightweight, zero-dependency chart library inspired by uPlot. Canvas-based, high performance.",
  "author": "mango0422",
  "license": "MIT",
  "keywords": [
    "charts",
    "canvas",
    "visualization",
    "lightweight",
    "typescript",
    "zero-dependency",
    "uplot",
    "gauge",
    "pie",
    "bar",
    "progress",
    "stacked-bar",
    "heatmap",
    "radar",
    "funnel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mango0422/micro-charts"
  },
  "homepage": "https://github.com/mango0422/micro-charts#readme",
  "bugs": {
    "url": "https://github.com/mango0422/micro-charts/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./bar": {
      "import": {
        "types": "./dist/bar.d.ts",
        "default": "./dist/bar.js"
      },
      "require": {
        "types": "./dist/bar.d.ts",
        "default": "./dist/bar.cjs"
      }
    },
    "./gauge": {
      "import": {
        "types": "./dist/gauge.d.ts",
        "default": "./dist/gauge.js"
      },
      "require": {
        "types": "./dist/gauge.d.ts",
        "default": "./dist/gauge.cjs"
      }
    },
    "./pie": {
      "import": {
        "types": "./dist/pie.d.ts",
        "default": "./dist/pie.js"
      },
      "require": {
        "types": "./dist/pie.d.ts",
        "default": "./dist/pie.cjs"
      }
    },
    "./progress": {
      "import": {
        "types": "./dist/progress.d.ts",
        "default": "./dist/progress.js"
      },
      "require": {
        "types": "./dist/progress.d.ts",
        "default": "./dist/progress.cjs"
      }
    },
    "./colors": {
      "import": {
        "types": "./dist/colors.d.ts",
        "default": "./dist/colors.js"
      },
      "require": {
        "types": "./dist/colors.d.ts",
        "default": "./dist/colors.cjs"
      }
    },
    "./easing": {
      "import": {
        "types": "./dist/easing.d.ts",
        "default": "./dist/easing.js"
      },
      "require": {
        "types": "./dist/easing.d.ts",
        "default": "./dist/easing.cjs"
      }
    },
    "./stacked-bar": {
      "import": {
        "types": "./dist/stacked-bar.d.ts",
        "default": "./dist/stacked-bar.js"
      },
      "require": {
        "types": "./dist/stacked-bar.d.ts",
        "default": "./dist/stacked-bar.cjs"
      }
    },
    "./heatmap": {
      "import": {
        "types": "./dist/heatmap.d.ts",
        "default": "./dist/heatmap.js"
      },
      "require": {
        "types": "./dist/heatmap.d.ts",
        "default": "./dist/heatmap.cjs"
      }
    },
    "./radar": {
      "import": {
        "types": "./dist/radar.d.ts",
        "default": "./dist/radar.js"
      },
      "require": {
        "types": "./dist/radar.d.ts",
        "default": "./dist/radar.cjs"
      }
    },
    "./funnel": {
      "import": {
        "types": "./dist/funnel.d.ts",
        "default": "./dist/funnel.js"
      },
      "require": {
        "types": "./dist/funnel.d.ts",
        "default": "./dist/funnel.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsup --config tsup.iife.config.ts",
    "build:esm": "tsup",
    "build:iife": "tsup --config tsup.iife.config.ts",
    "dev": "NODE_ENV=development tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
